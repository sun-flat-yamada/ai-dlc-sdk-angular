# =================================================================
# Build output & caches
# =================================================================
/dist
/tmp
/out-tsc
/.angular/cache
/.angular
/coverage
.sass-cache/
*.tsbuildinfo

# =================================================================
# Dependencies
# =================================================================
/node_modules
# Vitest cache of the harness tests (vitest.config.ts uses .ai-dlc/tools as its root)
/.ai-dlc/tools/node_modules/
npm-debug.log*
yarn-error.log

# =================================================================
# Tests
# =================================================================
/test-results/
/playwright-report/
/blob-report/
__screenshots__/

# =================================================================
# AI-DLC harness outputs (generated by .ai-dlc/tools)
# Keep only the directory skeleton and its README.
# =================================================================
/.ai-dlc/outputs/**
!/.ai-dlc/outputs/**/
!/.ai-dlc/outputs/README.md
!/.ai-dlc/outputs/**/.gitkeep
# Copilot CLI session exports created outside the harness
copilot-session-*.md

# =================================================================
# Secrets & credentials (never commit)
# =================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
secrets.*
.npmrc
# Extra CA certificates for the sandbox image (local only)
/.devcontainer/certs/*
!/.devcontainer/certs/README.md

# =================================================================
# Editors & OS
# =================================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
.history/

# Office lock files (Excel test specifications)
~$*
