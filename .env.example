# Repository defaults for contributor tooling. Copy to `.env` (git-ignored) to override locally;
# a process environment variable (in a Claude Code cloud session: the environment's variables) wins over both.

# PR Auto-Pilot (`npm run pr:finish`, CONTRIBUTING.md "Merging pull requests"):
#   true / 1   open pull requests ready for review and let `pr:finish` approve and rebase-merge them once CI is green
#   anything else / unset   open pull requests as drafts and merge them by hand
PR_AUTO_PILOT=true
